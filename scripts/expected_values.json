{
  "description": "Expected SPI MOSI byte sequences and Unity assertions for HIL/hardware test verification",
  "board": "ATmega328P (Arduino Nano)",
  "spi_pins": { "CS": 10, "MOSI": 11, "MISO": 12, "SCK": 13 },
  "osci_channels": { "CS": "CHAN1", "SCLK": "CHAN3", "MISO": "CHAN2", "MOSI": "CHAN4" },
  "tests": [
    {
      "name": "begin",
      "serial_assert": "begin() OK",
      "spi_mosi_bytes": [120, 121],
      "spi_mosi_labels": ["CMD_RESET 0x78", "SREAD|RESERVED3 0x79"]
    },
    {
      "name": "unlock",
      "serial_assert": "unlock() succeeded",
      "spi_mosi_bytes": [198],
      "spi_mosi_labels": ["IWRITE|LOCK 0xC6"]
    },
    {
      "name": "config0",
      "serial_assert": "config0(CONVERSION, BIAS_0UA, EXTERN) succeeded",
      "spi_mosi_bytes": [134, 192],
      "spi_mosi_labels": ["IWRITE|CONFIG0 0x86", "0xC0"]
    },
    {
      "name": "config1",
      "serial_assert": "config1(OSR_256, MCLK_0) succeeded",
      "spi_mosi_bytes": [136, 64],
      "spi_mosi_labels": ["IWRITE|CONFIG1 0x88", "0x40"]
    },
    {
      "name": "config2",
      "serial_assert": "config2(GAIN_1, BOOST_2) succeeded",
      "spi_mosi_bytes": [138, 137],
      "spi_mosi_labels": ["IWRITE|CONFIG2 0x8A", "0x89"]
    },
    {
      "name": "config3",
      "serial_assert": "config3(SGN_DATA, CONTINUOUS) succeeded",
      "spi_mosi_bytes": [140, 16],
      "spi_mosi_labels": ["IWRITE|CONFIG3 0x8C", "0x10"]
    },
    {
      "name": "irq",
      "serial_assert": "irq(IRQ_OFF) succeeded",
      "spi_mosi_bytes": [142, 0],
      "spi_mosi_labels": ["IWRITE|IRQ 0x8E", "0x00"]
    },
    {
      "name": "mux",
      "serial_assert": "mux(CH0, AGND) succeeded",
      "spi_mosi_bytes": [154, 8],
      "spi_mosi_labels": ["IWRITE|MUX 0x9A", "0x08"]
    },
    {
      "name": "analogRead_CH0",
      "serial_assert": "CH0: raw=",
      "spi_mosi_bytes": [154, 8, 104, 129],
      "spi_mosi_labels": ["IWRITE|MUX 0x9A", "0x08", "CMD_CONVERSION 0x68", "SREAD|ADCDATA 0x81"]
    },
    {
      "name": "analogRead_CH1",
      "serial_assert": "CH1: raw=",
      "spi_mosi_bytes": [154, 24, 104, 129],
      "spi_mosi_labels": ["IWRITE|MUX(CH1) 0x9A", "0x18", "CMD_CONVERSION 0x68", "SREAD|ADCDATA 0x81"]
    },
    {
      "name": "analogRead_CH2",
      "serial_assert": "CH2: raw=",
      "spi_mosi_bytes": [154, 40, 104, 129],
      "spi_mosi_labels": ["IWRITE|MUX(CH2) 0x9A", "0x28", "CMD_CONVERSION 0x68", "SREAD|ADCDATA 0x81"]
    },
    {
      "name": "analogRead_CH3",
      "serial_assert": "CH3: raw=",
      "spi_mosi_bytes": [154, 56, 104, 129],
      "spi_mosi_labels": ["IWRITE|MUX(CH3) 0x9A", "0x38", "CMD_CONVERSION 0x68", "SREAD|ADCDATA 0x81"]
    }
  ]
}
